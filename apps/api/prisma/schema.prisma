// Phase 1 schema: planning tool + read-only provider directory.
// Marketplace entities (Bid, Booking, Payment, Message, Review, Dispute) arrive in Phase 2.

generator client {
  provider      = "prisma-client-js"
  // native for local dev; rhel-openssl-3.0.x for Vercel Functions (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app; direct (unpooled) connection for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  TRAVELER
  GUIDE
  COMPANY
  TRANSPORT
  ADMIN
}

enum TripStatus {
  DRAFT
  ARCHIVED
  /// Posted for bids; the plan is frozen.
  POSTED
  /// A bid was accepted.
  BOOKED
  COMPLETED
}

enum PostStatus {
  OPEN
  /// A bid was accepted.
  CLOSED
  WITHDRAWN
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum ServiceNeed {
  GUIDE_AND_TRANSPORT
  GUIDE_ONLY
  TRANSPORT_ONLY
}

enum TransportMode {
  CAR_DRIVER
  SELF_DRIVE
  TUK_TUK
  BUS
  TRAIN
}

enum ProviderType {
  GUIDE
  COMPANY
  TRANSPORT
}

enum DocumentKind {
  ID
  LICENCE
  BUSINESS_REG
  INSURANCE
  PHOTO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMITTED
}

enum LocationSource {
  /// Hand-written content with fees, hours and notes.
  CURATED
  /// A place a traveller picked from Google search; coordinates only.
  GOOGLE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(TRAVELER)
  currency     String   @default("USD")
  language     String   @default("en")
  interests    String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips         Trip[]
  auditLogs     AuditLog[]
  provider      ProviderProfile?
  notifications Notification[]
  bookings      Booking[]
  conversations Conversation[]
}

model Location {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  nameSi         String?
  nameTa         String?
  category       String
  region         String
  /// Interest ids this place serves (culture, beaches, wildlife, ...).
  tags           String[]
  lat            Float
  lng            Float
  summary        String
  description    String
  bestTime       String?
  /// Per-person entry fee for foreign visitors, whole USD. Approximate.
  entryFeeUsd    Int            @default(0)
  openingHours   String?
  avgDurationMin Int            @default(120)
  accessibility  String?
  safety         String?
  amenities      String[]
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  imageUrl       String?
  /// Placeholder art tone until real photography is licensed.
  hue            String         @default("sand")
  /// When ops last checked fees and hours against an official source.
  verifiedAt     DateTime?
  source         LocationSource @default(CURATED)
  /// Google Places id for source = GOOGLE, so a place is only stored once.
  googlePlaceId  String?        @unique
  address        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tripStops      TripStop[]
  itineraryStops ItineraryStop[]

  @@index([category])
  @@index([region])
  @@index([source])
}

model Trip {
  id          String     @id @default(cuid())
  userId      String
  title       String
  startDate   DateTime?  @db.Date
  travelers   Int        @default(2)
  status      TripStatus @default(DRAFT)
  /// BudgetSettings from @sln/core.
  budget      Json
  itineraryId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary     Itinerary?     @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  stops         TripStop[]
  post          TripPost?
  /// Past bookings stay on record: a cancelled trip can be posted and booked again.
  bookings      Booking[]
  conversations Conversation[]

  @@index([userId, status])
}

/// Join table between Trip and Location, ordered. Holds the leg to the next stop.
model TripStop {
  id             String        @id @default(cuid())
  tripId         String
  locationId     String
  position       Int
  nights         Int           @default(1)
  modeToNext     TransportMode @default(CAR_DRIVER)
  legDistanceKm  Int?
  legDurationMin Int?
  legSource      String?

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([tripId, position])
}

model Itinerary {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  days      Int
  hue       String   @default("sand")
  tags      String[]
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  stops ItineraryStop[]
  trips Trip[]
}

model ItineraryStop {
  id          String        @id @default(cuid())
  itineraryId String
  locationId  String
  position    Int
  nights      Int           @default(1)
  modeToNext  TransportMode @default(CAR_DRIVER)

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([itineraryId, position])
}

/// Phase 1: entered by admins to seed supply. Self-registration opens in Phase 2.
model ProviderProfile {
  id                 String                 @id @default(cuid())
  slug               String                 @unique
  type               ProviderType
  displayName        String
  city               String
  bio                String
  languages          String[]
  specialties        String[]
  areas              String[]
  yearsActive        Int                    @default(0)
  verificationStatus VerificationStatus     @default(PENDING)
  rating             Float                  @default(0)
  reviewCount        Int                    @default(0)
  responseTimeMin    Int?
  priceFromUsd       Int?
  priceToUsd         Int?
  phone              String?
  email              String?
  /// Demo data for development; never shown as real in production.
  isSample           Boolean                @default(false)
  /// Set when the provider registered themselves; null for admin-entered profiles.
  userId             String?                @unique
  licenceNumber      String?
  businessRegNo      String?
  /// Null while the application is still a draft; set when submitted for review.
  submittedAt        DateTime?
  reviewedAt         DateTime?
  /// Why changes were requested; shown to the provider.
  reviewNote         String?
  videoCallAt        DateTime?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents          VerificationDocument[]
  bids               Bid[]
  bookings           Booking[]
  conversations      Conversation[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([type, verificationStatus])
}

model FxRate {
  currency  String   @id
  /// Units of `currency` per 1 USD.
  perUsd    Float
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  notes      String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
}

/// ID, licence and insurance scans. Stored in Postgres (encrypted at rest by the
/// host) behind a storage interface; only admins can read them back.
model VerificationDocument {
  id         String       @id @default(cuid())
  providerId String
  kind       DocumentKind
  filename   String
  mime       String
  size       Int
  data       Bytes
  uploadedAt DateTime     @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, kind])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  /// App path to open, e.g. /provider/profile
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A trip put to the marketplace: the traveller's request that guides bid on.
model TripPost {
  id           String      @id @default(cuid())
  tripId       String      @unique
  userId       String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  adults       Int
  children     Int         @default(0)
  budgetMinUsd Int
  budgetMaxUsd Int
  need         ServiceNeed @default(GUIDE_AND_TRANSPORT)
  /// Interest ids (culture, birding, ...) used to match providers.
  interests    String[]
  /// Languages the traveller would like the guide to speak.
  languages    String[]
  notes        String      @default("")
  /// Bids are accepted until this time; the traveller may still accept later.
  deadline     DateTime
  status       PostStatus  @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bids Bid[]

  @@index([status, deadline])
}

model Bid {
  id                    String    @id @default(cuid())
  postId                String
  providerId            String
  /// Total price for the whole group, whole USD.
  priceUsd              Int
  /// CAR_DRIVER, GUIDE, ENTRY_FEES, ACCOMMODATION, MEALS, ...
  inclusions            String[]
  pitch                 String
  availabilityConfirmed Boolean   @default(true)
  status                BidStatus @default(PENDING)
  /// The traveller's shortlist.
  shortlisted           Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  post     TripPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking?

  @@unique([postId, providerId])
  @@index([providerId, status])
}

/// An accepted bid. Payment is arranged directly for now; the commission is
/// recorded so the amounts are already right when online payment arrives.
model Booking {
  id            String        @id @default(cuid())
  tripId        String
  postId        String
  bidId         String        @unique
  travellerId   String
  providerId    String
  priceUsd      Int
  commissionPct Int
  commissionUsd Int
  status        BookingStatus @default(CONFIRMED)
  cancelledById String?
  cancelReason  String?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bid       Bid             @relation(fields: [bidId], references: [id], onDelete: Restrict)
  traveller User            @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([travellerId])
  @@index([providerId, status])
}

/// One thread per trip and provider: used for questions before bidding, for
/// negotiating while bids are open, and for coordinating once booked.
model Conversation {
  id              String    @id @default(cuid())
  tripId          String
  travellerId     String
  providerId      String
  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())
  /// When each side last opened the thread; anything newer from the other side is unread.
  travellerReadAt DateTime?
  providerReadAt  DateTime?

  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  traveller User            @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([tripId, providerId])
  @@index([travellerId, lastMessageAt])
  @@index([providerId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
