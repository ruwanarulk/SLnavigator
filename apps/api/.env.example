# Copy to .env and fill in.
DATABASE_URL="postgresql://USER@localhost:5432/sri_lanka_navigator?schema=public"
DATABASE_URL_UNPOOLED= # direct connection for migrations; locally the same as DATABASE_URL
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Long random string; `openssl rand -hex 32`
JWT_SECRET=
# Optional. Server-side key with the Routes API enabled; drive times fall back to estimates without it.
GOOGLE_MAPS_SERVER_KEY=

# Dev seed accounts (npm run db:seed). Use test values only.
SEED_ADMIN_EMAIL=admin@navigator.test
SEED_ADMIN_PASSWORD=
SEED_TRAVELER_EMAIL=traveller@navigator.test
SEED_TRAVELER_PASSWORD=

# Optional. Sentry DSN for the API project; errors are only sent when set.
SENTRY_DSN=
