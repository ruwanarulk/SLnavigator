# Copy to .env.local. All optional for local development.

# Where the NestJS API runs (server-side fetches and the /api rewrite).
API_URL=http://localhost:4000

# Browser key for the Maps JavaScript API. Without it the planner uses the
# built-in stylised island map. Restrict the key to your domains (HTTP referrers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# A Map ID from Google Cloud (needed for Advanced Markers). Defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Set to 1 to re-enable Turbopack's dev cache (only on APFS/ext4, not NTFS).
NEXT_DEV_FS_CACHE=
